#include <stdio.h>
int main()
{
   int a, b, c, d, e, Total;
   float Avg;
     printf("Enter marks of 5 subjects: ");
     scanf("%d%d%d%d%d", &a, &b, &c, &d, &e);
   Total = a + b + c + d + e;
   Avg = Total / 5;
     printf("\nTotal marks = %d", Total);
     printf("\nAverage marks = %.2f", Avg);
}
