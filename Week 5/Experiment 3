#include <stdio.h>
#include <math.h>

int main()
{
    float a, b, c, D, R1, R2;
     printf("Enter a, b and c: ");
     scanf("%f%f%f", &a, &b, &c);
    D = b * b - 4 * a * c;
    if (D >= 0)
    {
        R1 = (-b + sqrt(D)) / (2 * a);
        R2 = (-b - sqrt(D)) / (2 * a);
        printf("\nRoot 1 = %.2f", R1);
        printf("\nRoot 2 = %.2f", R2);
    }
    else
    {
        printf("Roots are imaginary");
    }
}
